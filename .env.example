# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord

# Session & Admin Access
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Comma-separated Discord user IDs granted super_admin role
ADMIN_DISCORD_IDS=

# GitHub Gist (optional — leave empty to store CDN servers locally in data/panel-db.json)
GITHUB_GIST_ID=
GITHUB_GIST_TOKEN=

# Optional secrets for CDN Worker sync & Debug log clearing
CDN_WORKER_SECRET=
DEBUG_SECRET=
